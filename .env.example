# Core deployment
PLODA_ENV=production
HOST=0.0.0.0
PORT=8080
BASE_URL=https://ploda.org
PLODA_DB_PATH=/data/ploda.db

# Bank transfer
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# EcoCash merchant integration
ECOCASH_API_URL=
ECOCASH_API_KEY=
ECOCASH_MERCHANT_ID=
ECOCASH_WEBHOOK_SECRET=

# Hosted Visa / card payment page provided by your acquiring bank or PSP.
# The portal deliberately never collects card numbers itself.
VISA_CHECKOUT_URL=

# PayPal merchant integration
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

